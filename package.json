{
  "name": "dsh-discord-cyberfriend",
  "version": "1.0.3",
  "description": "Discord-cyberfriend (Discord 賽博群友): a DSH companion that chats, reacts and speaks on Discord through a bot or a user account.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "skills",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "bridge",
    "requirements.txt",
    "scripts",
    "requirements.lock.txt",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "INSTALL.md",
    "README.en.md",
    "INSTALL.en.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "RELEASE.md",
    "client-src",
    "tests",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/*.log",
    "!**/.env*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "ffmpeg-static": "5.3.0",
    "opencc-js": "1.4.2",
    "opusscript": "0.0.8",
    "prism-media": "1.3.5"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "engines": {
    "node": ">=22.15"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check && node --check client.js",
    "check:release": "node scripts/check-release.mjs"
  },
  "author": {
    "name": "puffdog-git",
    "url": "https://github.com/puffdog-git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "discord",
    "discord-bot",
    "chatbot",
    "voice",
    "companion"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puffdog-git/dsh-discord-cyberfriend.git"
  },
  "homepage": "https://github.com/puffdog-git/dsh-discord-cyberfriend#readme",
  "bugs": {
    "url": "https://github.com/puffdog-git/dsh-discord-cyberfriend/issues"
  }
}
